{
  "version": 8,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/${presetName}",
      "architecture": { "value": "x64", "strategy": "external" },
      "environment": { "VSLANG": "1033" },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.deps/vcpkg-0699a19d0c6386247ce50d4dedbb8217d484d536/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-dll-mt",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/.deps/vcpkg_installed",
        "X_VCPKG_APPLOCAL_DEPS_INSTALL": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (MSVC, Ninja)",
      "inherits": "base",
      "installDir": "${sourceDir}/build/Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release (MSVC, Ninja)",
      "inherits": "base",
      "installDir": "${sourceDir}/build/Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    {
      "name": "debug", "configurePreset": "debug",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "live" } },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "release", "configurePreset": "release",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "live" } },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
