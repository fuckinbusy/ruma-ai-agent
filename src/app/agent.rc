// agent.exe resources: the product icon (variant A, the tile) and the version, both from one source.
#include <winres.h>

#include "resource.h"
#include "wa_version.h"

IDI_APPICON ICON "icon/A_tile.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION WA_VERSION_MAJOR, WA_VERSION_MINOR, WA_VERSION_PATCH, 0
 PRODUCTVERSION WA_VERSION_MAJOR, WA_VERSION_MINOR, WA_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "WinAiAgent"
            VALUE "FileDescription", "WinAiAgent"
            VALUE "FileVersion", WA_VERSION_TEXT
            VALUE "InternalName", "agent"
            VALUE "OriginalFilename", "agent.exe"
            VALUE "ProductName", "WinAiAgent"
            VALUE "ProductVersion", WA_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
